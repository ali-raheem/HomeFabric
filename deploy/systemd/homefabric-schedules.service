[Unit]
Description=HomeFabric process_schedules (one pass)

[Service]
Type=oneshot
User=homefabric
Group=homefabric
WorkingDirectory=/opt/homefabric
Environment=FABRIC_CONFIG_FILE=/etc/homefabric/fabric.toml
ExecStart=/opt/homefabric/.venv/bin/homefabric process_schedules --once
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/homefabric
