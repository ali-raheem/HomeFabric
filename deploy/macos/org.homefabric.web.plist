<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.homefabric.web</string>
  <key>ProgramArguments</key><array><string>/opt/homefabric/.venv/bin/homefabric</string><string>serve</string></array>
  <key>EnvironmentVariables</key><dict><key>FABRIC_CONFIG_FILE</key><string>/usr/local/etc/homefabric/fabric.toml</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/usr/local/var/log/homefabric-web.log</string>
</dict></plist>
